+    def _timestamp_seconds(series: pd.Series) -> pd.Series:
+        values = pd.to_datetime(series, utc=True)
+        nanoseconds = values.dt.as_unit("ns").astype("int64")
+        return (nanoseconds // 1_000_000_000).astype("int64")
+
+    def _timestamp_milliseconds(series: pd.Series) -> pd.Series:
+        values = pd.to_datetime(series, utc=True)
+        nanoseconds = values.dt.as_unit("ns").astype("int64")
+        return (nanoseconds // 1_000_000).astype("int64")
+
+    # Parquet preserves datetime64[us]. The recovered adapter divided the raw
+    # physical integers as though they were nanoseconds, emptying every as-of
+    # join. Normalize to nanoseconds explicitly before epoch conversion.
+    data_module._timestamp_seconds = _timestamp_seconds
+    data_module._timestamp_milliseconds = _timestamp_milliseconds
+
     def normalize_obadiaha_source(
         markets: pd.DataFrame,
         resolutions: pd.DataFrame,
