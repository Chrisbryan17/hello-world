+def summarize_asset(frame: pd.DataFrame) -> dict[str, Any]:
+    fills = frame.loc[frame["hypothetical_fok_fill"]].copy()
+    labeled = fills.loc[fills["won"].notna()].copy()
+    win_rate = float(labeled["won"].astype(bool).mean()) if len(labeled) else None
+    mean_pnl = float(labeled["pnl_per_share"].mean()) if len(labeled) else None
+    return {
+        "markets": int(len(frame)),
+        "signals": int(frame["signal"].sum()),
+        "hypothetical_fok_fills": int(len(fills)),
+        "labeled_fills": int(len(labeled)),
+        "unlabeled_fills": int(len(fills) - len(labeled)),
+        "inferred_label_wins": int(labeled["won"].astype(bool).sum()),
+        "inferred_label_win_rate": win_rate,
+        "inferred_label_mean_pnl_per_share": mean_pnl,
+        "inferred_label_pnl_at_five_shares": float(labeled["pnl_at_five_shares"].sum()),
+        "first_market_start": str(frame["market_start"].min()),
