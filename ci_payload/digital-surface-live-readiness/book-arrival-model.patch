diff --git a/tests/digital_surface/test_execution.py b/tests/digital_surface/test_execution.py
--- a/tests/digital_surface/test_execution.py
+++ b/tests/digital_surface/test_execution.py
@@ -59,3 +59,36 @@
     bad = replay_single_leg_fok(signals, books(), tape(prearrival_only=True), shares=5)
     assert good.iloc[0].filled and good.iloc[0].pnl > 0
     assert not bad.iloc[0].filled
+
+
+def test_book_arrival_model_uses_post_latency_executable_depth_without_future_tape():
+    conservative = replay_atomic_fok(
+        candidate(), books(), tape(prearrival_only=True), shares=5, latency_ms=1000
+    )
+    estimated = replay_atomic_fok(
+        candidate(),
+        books(),
+        tape(prearrival_only=True),
+        shares=5,
+        latency_ms=1000,
+        fill_model="book_arrival",
+    )
+    assert not conservative.iloc[0].atomic
+    assert estimated.iloc[0].atomic
+    assert estimated.iloc[0].fill_model == "book_arrival"
+    assert estimated.iloc[0].low_yes_book_executable
+    assert estimated.iloc[0].high_no_book_executable
+    assert not estimated.iloc[0].low_yes_tape_confirmed
+    assert not estimated.iloc[0].high_no_tape_confirmed
+
+
+def test_book_arrival_model_still_rejects_missing_or_uncrossable_books():
+    missing_high = books().loc[lambda frame: frame["condition_id"] != "high"]
+    missing = replay_atomic_fok(
+        candidate(), missing_high, tape(), shares=5, latency_ms=1000, fill_model="book_arrival"
+    )
+    expensive = replay_atomic_fok(
+        candidate(), books(high_ask=.60), tape(), shares=5, latency_ms=1000, fill_model="book_arrival"
+    )
+    assert not missing.iloc[0].atomic
+    assert not expensive.iloc[0].atomic
